# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Audio-file I/O and resampling for SoundML"
description:
  "SoundML I/O decodes and encodes audio with libsndfile and optionally resamples it with SoXR."
maintainer: ["Gabriel Santamaria <gaby.santamaria@outlook.fr>"]
authors: ["Gabriel Santamaria <gaby.santamaria@outlook.fr>"]
license: "Apache-2.0"
tags: ["sound" "audio" "file-io" "resampling"]
homepage: "https://github.com/gabyfle/SoundML"
doc: "https://soundml.dev"
bug-reports: "https://github.com/gabyfle/SoundML/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "soundml" {= version}
  "nx" {= "dev"}
  "conf-c++" {build}
  "conf-pkg-config" {build}
  "conf-sndfile" {build}
  "conf-samplerate" {build}
  "dune-configurator" {build}
  "odoc" {with-doc}
  "windtrap" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/gabyfle/SoundML.git"
x-maintenance-intent: ["(latest)"]
pin-depends: [
  [
    "nx.dev"
    "git+https://github.com/raven-ml/raven.git#d9facbc227ddc80d644bdeff0d94cf76d6a0c07b"
  ]
]

depexts: [
  ["libsoxr-dev"] {os-family = "debian" | os-family = "ubuntu"}
  ["soxr"] {os-family = "arch"}
  ["soxr-dev"] {os-distribution = "alpine"}
  ["soxr-devel"] {os-family = "fedora" | os-distribution = "centos" | os-distribution = "rhel"}
  ["audio/libsoxr"] {os = "freebsd" | os = "openbsd"}
  ["soxr"] {os = "macos" & os-distribution = "homebrew"}
]
