homepage: "https://github.com/gabyfle/SoundML"
doc: "https://soundml.dev"
bug-reports: "https://github.com/gabyfle/SoundML/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.24"}
  "nx" {= "dev"}
  "odoc" {with-doc}
  "windtrap" {with-test}
  "thumper" {with-test}
  "yojson" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@runtest/soundml" {with-test}
    "@doc" {with-doc}
  ]
]
